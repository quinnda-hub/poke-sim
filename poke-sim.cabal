cabal-version:      3.0
-- The cabal-version field refers to the version of the .cabal specification,
-- and can be different from the cabal-install (the tool) version and the
-- Cabal (the library) version you are using. As such, the Cabal (the library)
-- version used must be equal or greater than the version stated in this field.
-- Starting from the specification version 2.2, the cabal-version field must be
-- the first thing in the cabal file.

-- Initial package description 'poke-sim' generated by
-- 'cabal init'. For further documentation, see:
--   http://haskell.org/cabal/users-guide/
--
-- The name of the package.
name:               poke-sim

-- The package version.
-- See the Haskell package versioning policy (PVP) for standards
-- guiding when and how versions should be incremented.
-- https://pvp.haskell.org
-- PVP summary:     +-+------- breaking API changes
--                  | | +----- non-breaking API additions
--                  | | | +--- code changes with no API change
version:            0.1.0.0

-- A short (one-line) description of the package.
-- synopsis:

-- A longer description of the package.
-- description:

-- The license under which the package is released.
license:            BSD-3-Clause

-- The file containing the license text.
license-file:       LICENSE

-- The package author(s).
author:             quinn

-- An email address to which users can send suggestions, bug reports, and patches.
maintainer:         qda869@usask.ca

-- A copyright notice.
-- copyright:
category:           Game
build-type:         Simple

-- Extra doc files to be distributed with the package, such as a CHANGELOG or a README.
extra-doc-files:    CHANGELOG.md

-- Extra source files to be distributed with the package, such as examples, or a tutorial module.
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    -- Import common warning flags.
    import:           warnings

    default-extensions:  StrictData

    -- Modules exported by the library.
    exposed-modules:  MyLib,
                      Pokemon.Convert,
                      Pokemon.Pretty,
                      Pokemon.AI.Internal,
                      Pokemon.AI.Types,
                      Pokemon.Battle.Ability, 
                      Pokemon.Battle.Ability.Internal,
                      Pokemon.Battle.Pokemon.Internal,
                      Pokemon.Battle.Pokemon,
                      Pokemon.Battle.Action,
                      Pokemon.Battle.Action.Internal,
                      Pokemon.Battle.Action.MoveAction,
                      Pokemon.Battle.Action.SwitchAction,
                      Pokemon.Battle.Damage.Internal,
                      Pokemon.Battle.Logging,
                      Pokemon.Battle.BattleState.Internal,
                      Pokemon.Battle.BattleState.Types,
                      Pokemon.Battle.BattleState.PlayerSlot,
                      Pokemon.Battle.BattleState,
                      Pokemon.Battle.Simulation.Internal,
                      Pokemon.Battle.Simulation.Modes,
                      Pokemon.Battle.Simulation,
                      Pokemon.Data.Move.Internal,
                      Pokemon.Battle.MoveEffect.Internal,
                      Pokemon.Battle.MoveEffect.Boosts,
                      Pokemon.Battle.MoveEffect.ConditionalDamage,
                      Pokemon.Battle.MoveEffect.Damage,
                      Pokemon.Battle.MoveEffect.DelayedMove,
                      Pokemon.Battle.MoveEffect.GenericSelfHeal,
                      Pokemon.Battle.MoveEffect.MultiHitDamage,
                      Pokemon.Battle.MoveEffect.Status,
                      Pokemon.Battle.MoveEffect.RecoilDamage,
                      Pokemon.Battle.MoveEffect,
                      Pokemon.Data.Move,
                      Pokemon.Data.Pokedex.Internal,
                      Pokemon.Data.Pokedex,
                      Pokemon.Mechanics.PType,
                      Pokemon.Mechanics.Weather,
                      Pokemon.Parse.PokePaste,
                      Engine,
                      Engine.Chance,
                      Engine.Choice,
                      Engine.Damage,
                      Engine.Dex,
                      Engine.Format,
                      Engine.Queue,
                      Engine.State,
                      Engine.Stats,
                      Engine.Team,
                      Engine.Turn

    -- Modules included in this library but not exported.
    other-modules:

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- Other library packages from which modules are imported.
    build-depends:    base ^>= 4.17.2.1,
                      bytestring >= 0.11.5 && < 0.12,
                      aeson >= 2.2.3 && < 2.3,
                      attoparsec >= 0.14.4 && < 0.15,
                      containers >= 0.6.7 && < 0.7,
                      mtl >= 2.2.2 && < 2.3,
                      text >= 2.0.2 && < 2.1,
                      transformers >= 0.5.6 && <= 0.6,
                      random >= 1.2.1 && < 1.3,
                      vector >= 0.13.2 && < 0.14,
                      scientific >= 0.3.7 && < 0.4,
                      splitmix >= 0.1.0.4 && < 0.2,
                      filepath >= 1.4 && < 1.6

    -- Directories containing source files.
    hs-source-dirs:   src

    -- Base language which the package is written in.
    default-language: Haskell2010

    ghc-options: -O2
                 -funbox-small-strict-fields

executable poke-sim
    -- Import common warning flags.
    import:           warnings

    -- .hs or .lhs file containing the Main module.
    main-is:          Main.hs

    -- Modules included in this executable, other than Main.
    -- other-modules:

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- Other library packages from which modules are imported.
    build-depends:
        base ^>=4.17.2.1,
        poke-sim

    -- Directories containing source files.
    hs-source-dirs:   app

    -- Base language which the package is written in.
    default-language: Haskell2010

    ghc-options: -O2
                 -threaded

test-suite poke-sim-test
    -- Import common warning flags.
    import:           warnings

    -- Base language which the package is written in.
    default-language: Haskell2010

    -- Modules included in this executable, other than Main.
    -- other-modules:

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- The interface type and version of the test suite.
    type:             exitcode-stdio-1.0

    -- Directories containing source files.
    hs-source-dirs:   test

    -- The entrypoint to the test suite.
    main-is:          Main.hs

    -- Test dependencies.
    build-depends:
        base ^>=4.17.2.1,
        poke-sim

-- Replays recorded Showdown battles (traces) against the engine: draws and state must match.
test-suite parity
    import:           warnings
    default-language: Haskell2010
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test/parity
    main-is:          Main.hs
    ghc-options:      -O1
    build-depends:
        base ^>=4.17.2.1,
        poke-sim,
        aeson >= 2.2.3 && < 2.3,
        bytestring >= 0.11.5 && < 0.12,
        containers >= 0.6.7 && < 0.7,
        directory >= 1.3 && < 1.4,
        filepath >= 1.4 && < 1.6,
        scientific >= 0.3.7 && < 0.4,
        text >= 2.0.2 && < 2.1,
        vector >= 0.13.2 && < 0.14

-- Random-playout throughput of the engine on one core.
benchmark playouts
    import:           warnings
    default-language: Haskell2010
    type:             exitcode-stdio-1.0
    hs-source-dirs:   bench
    main-is:          Main.hs
    ghc-options:      -O2
    build-depends:
        base ^>=4.17.2.1,
        poke-sim,
        aeson >= 2.2.3 && < 2.3,
        directory >= 1.3 && < 1.4,
        filepath >= 1.4 && < 1.6,
        splitmix >= 0.1.0.4 && < 0.2,
        vector >= 0.13.2 && < 0.14

-- Reports which usage-whitelist entries the engine does not support yet.
executable whitelist-report
    import:           warnings
    default-language: Haskell2010
    main-is:          Main.hs
    hs-source-dirs:   tools/whitelist-report
    build-depends:
        base ^>=4.17.2.1,
        poke-sim,
        aeson >= 2.2.3 && < 2.3,
        containers >= 0.6.7 && < 0.7,
        scientific >= 0.3.7 && < 0.4,
        text >= 2.0.2 && < 2.1,
        vector >= 0.13.2 && < 0.14
